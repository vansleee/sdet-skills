{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(gh pr merge*)",
      "Bash(docker compose down -v*)",
      "Bash(docker-compose down -v*)",
      "Bash(dropdb*)"
    ]
  }
}
