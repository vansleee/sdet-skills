{
  "name": "sdet-skills",
  "version": "0.1.0",
  "description": "Agentic SDET skills — GitHub Actions · Playwright (TS) · GitHub Issues",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run check:manifest && npm run check:config && npm run check:tone",
    "check:manifest": "bash scripts/check-manifest.sh",
    "check:tone": "python3 scripts/check-de-ai-tone.py",
    "test:list": "playwright test --config tests/playwright.config.ts --list --reporter=line",
    "test": "playwright test --config tests/playwright.config.ts",
    "test:clean": "SUT=clean playwright test --config tests/playwright.config.ts tests/e2e",
    "test:with-bugs": "SUT=with-bugs playwright test --config tests/playwright.config.ts tests/e2e",
    "test:flaky": "playwright test --config tests/playwright.config.ts tests/flaky --repeat-each=20",
    "check:config": "python3 scripts/check-config-contract.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
