node_modules/
.env
.env.*
test-results/
playwright-report/
.pw-mcp-traces/
*.zip
.DS_Store
.playwright-mcp/
.playwright-cli/
.fuse_hidden*

# 受測專案：projects/<slug>/ 的 config 與 knowledge 是真檔，不進版控。
# 只 commit projects/_template/（新專案範本）與各專案的 charters/（探索章程是教材）。
/projects/*/config/
/projects/*/knowledge/
/projects/governance.yaml
!/projects/_template/config/
!/projects/_template/knowledge/

# 所有執行期產物與狀態檔都集中在 output/（2026-07-30 起），整個 gitignore。
# 只 commit references/state/ 下的 *.example.yaml 範本。真檔（evidence、verdicts、issues-index、
# calibration、gate、runs、reports…）全留本地。
# Playwright MCP 的 trace/snapshot 暫存也走 output/evidence/_traces/（見 README 的 MCP 設定）。
/output/

# 保險：舊版曾把產物落在 repo 根目錄，留著擋回頭路
/evidence/

# Claude Code 個人設定(不進版控;團隊共用的規則放 .claude/settings.json)
.claude/settings.local.json*

# Python 快取
__pycache__/
*.pyc
